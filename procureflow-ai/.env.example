# ProcureFlow AI — Environment Variables
# Fill in your actual API keys below before running

# === Band ===
BAND_API_KEY=your_default_band_agent_api_key_here
BAND_ROOM_ID=your_band_chat_room_id_here
BAND_WEBHOOK_SECRET=your_band_webhook_secret_here

# Recommended for judging: use one Agent API key per Band participant.
# Each key must belong to an External Agent that has been added to BAND_ROOM_ID.
BAND_INTAKE_API_KEY=your_intake_agent_api_key_here
BAND_RISK_API_KEY=your_risk_agent_api_key_here
BAND_POLICY_API_KEY=your_policy_agent_api_key_here
BAND_FEATHERLESS_REVIEW_API_KEY=your_optional_featherless_review_agent_api_key_here
BAND_APPROVAL_API_KEY=your_approval_agent_api_key_here

# Optional: keep the UUIDs copied from Band agent settings for your own notes.
BAND_INTAKE_AGENT_ID=your_intake_agent_uuid_here
BAND_RISK_AGENT_ID=your_risk_agent_uuid_here
BAND_POLICY_AGENT_ID=your_policy_agent_uuid_here
BAND_FEATHERLESS_REVIEW_AGENT_ID=your_optional_featherless_review_agent_uuid_here
BAND_APPROVAL_AGENT_ID=your_approval_agent_uuid_here

# === AI/ML API Partner Provider ===
# Preferred for the Band of Agents partner-prize path.
AI_PROVIDER=aimlapi
AIMLAPI_KEY=your_aimlapi_key_here
AIMLAPI_BASE_URL=https://api.aimlapi.com/v1
AIMLAPI_MODEL=google/gemma-3-4b-it

# === OpenRouter fallback ===
# Keep this only if you do not have AI/ML API access yet.
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini

# === Featherless AI Partner Provider ===
# Powers the independent open-source model review before human approval.
FEATHERLESS_API_KEY=your_featherless_api_key_here
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct

# === Supabase ===
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_service_role_key_here

# === Server ===
PORT=8000
ENVIRONMENT=development
