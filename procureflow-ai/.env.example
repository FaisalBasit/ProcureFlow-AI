# ProcureFlow AI — Environment Variables
# Fill in your actual API keys below before running

# === Band ===
BAND_API_KEY=your_default_band_agent_api_key_here
BAND_ROOM_ID=your_band_chat_room_id_here
BAND_WEBHOOK_SECRET=your_band_webhook_secret_here

# Optional: use separate Agent API keys for each Band participant.
# Each key must belong to an agent that has been added to BAND_ROOM_ID.
BAND_INTAKE_API_KEY=your_intake_agent_api_key_here
BAND_RISK_API_KEY=your_risk_agent_api_key_here
BAND_POLICY_API_KEY=your_policy_agent_api_key_here
BAND_APPROVAL_API_KEY=your_approval_agent_api_key_here

# === AI/ML (OpenRouter) ===
OPENROUTER_API_KEY=your_openrouter_api_key_here

# === Supabase ===
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_service_role_key_here

# === Server ===
PORT=8000
ENVIRONMENT=development
